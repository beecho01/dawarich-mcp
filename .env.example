# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Upstream Dawarich instance. Container-to-container in the example compose:
#   DAWARICH_BASE_URL=http://dawarich-app-1:3000
# For a host-published instance:
#   DAWARICH_BASE_URL=http://192.168.0.34:3007
DAWARICH_BASE_URL=

# The Dawarich API key does NOT go here: put it in ./secrets/dawarich_api_key
# (compose mounts it as a Docker secret), or set DAWARICH_API_KEY_FILE to your own path.

# If Dawarich runs behind a hostname (Rails production rejects untrusted Host headers)
# and you reach it by container name/IP, set:
DAWARICH_HOST_HEADER=
DAWARICH_FORWARDED_PROTO=https

# Comma-separated "label:sha256hex" entries. Create one with:
#   docker compose run --rm --no-deps mcp gen-token --label openwebui
# The token itself goes to your MCP client; only its hash goes here.
DAWARICH_MCP_AUTH_TOKEN_HASHES=

# MCP server image (leave as dawarich-mcp:local for a local build; use
# ghcr.io/beecho01/dawarich-mcp:1.0.0 for the published image):
# MCP_IMAGE=ghcr.io/beecho01/dawarich-mcp:latest

# If clients reach the server under another name (e.g. via a reverse proxy), add it here,
# otherwise requests are rejected by DNS-rebinding protection (HTTP 421/403).
# DAWARICH_MCP_ALLOWED_HOSTS=dawarich-mcp:*,127.0.0.1:*,mcp.example.internal
# DAWARICH_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*

# OAuth 2.1 resource-server mode (instead of static tokens):
# DAWARICH_MCP_OAUTH_ISSUER=https://auth.example.com/realms/main
# DAWARICH_MCP_OAUTH_JWKS_URL=https://auth.example.com/realms/main/protocol/openid-connect/certs
# DAWARICH_MCP_OAUTH_RESOURCE_URL=https://mcp.example.com/mcp
# DAWARICH_MCP_OAUTH_REQUIRED_SCOPES=dawarich:read

# DAWARICH_MCP_RATE_LIMIT_PER_MINUTE=60
# DAWARICH_MCP_LOG_LEVEL=INFO
